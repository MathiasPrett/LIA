TELEGRAM_BOT_TOKEN=
OWNER_USER_ID=
DATABASE_PATH=data/lia.db
LOG_LEVEL=INFO
TIMEZONE=America/Santiago
# Formato: id:etiqueta,id2:etiqueta2 (la etiqueta es opcional; sin ella se usa el id tal cual)
CALENDAR_IDS=primary:Personal
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
CANVAS_BASE_URL=https://tuinstitucion.instructure.com
CANVAS_ACCESS_TOKEN=
CANVAS_POLL_INTERVAL_MINUTES=20

# Fase 4: resumen semanal, recordatorios pre-evento y planificador
WEEKLY_BRIEFING_HOUR=20
WEEKLY_BRIEFING_MINUTE=0
REMINDER_LEAD_MINUTES=60
REMINDER_POLL_INTERVAL_MINUTES=10
IMPORTANT_MIN_DURATION_MINUTES=90
IMPORTANT_MIN_ATTENDEES=3
IMPORTANT_KEYWORDS=examen,entrega,presentación,certamen
# IDs de calendario cuyos eventos siempre se avisan (vacío = ninguno)
IMPORTANT_CALENDAR_IDS=
PLANNER_DAY_START_HOUR=8
PLANNER_DAY_END_HOUR=22

# Fase 5: recordatorios ad-hoc (no necesita config extra), clima y notas de voz.
# Ambas son opcionales — si faltan, el resto del bot funciona igual.
ADHOC_REMINDER_POLL_INTERVAL_MINUTES=1
GROQ_API_KEY=
WEATHER_LATITUDE=
WEATHER_LONGITUDE=

# Fase 6: endurecimiento
HEARTBEAT_PATH=data/heartbeat
HEARTBEAT_INTERVAL_MINUTES=2
BACKUP_DIR=data/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=7
LLM_BUDGET_USD=1.0
LLM_BUDGET_ALERT_THRESHOLD=0.8
LLM_BUDGET_CHECK_INTERVAL_HOURS=6
